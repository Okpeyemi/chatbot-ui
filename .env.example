# Provider API keys — set the ones you want to use.
# Only the model you actually select needs a matching key.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Web search (optional). When set, the `webSearch` tool uses Tavily
# (https://tavily.com — 1k free searches/month). Without a key, the bot falls
# back to DuckDuckGo's Instant Answer API (free, no key, but limited results).
TAVILY_API_KEY=
